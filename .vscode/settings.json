{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",

  // Pytest is enabled — tests live in greenvia_e2e/tests/
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "tests"
  ],
  "python.testing.cwd": "${workspaceFolder}/greenvia_e2e",

  "python.analysis.extraPaths": ["${workspaceFolder}/greenvia_e2e"],
  "python.analysis.typeCheckingMode": "basic",

  "terminal.integrated.cwd": "${workspaceFolder}/greenvia_e2e",
  "terminal.integrated.env.windows": {
    "PYTHONPATH": "${workspaceFolder}/greenvia_e2e",
    "PYTHONIOENCODING": "utf-8"
  },

  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/*.pyc": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/reports/screenshots": true
  },

  "[python]": {
    "editor.formatOnSave": false,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [88, 100]
  }
}
