# Copy this file to `.env` to override defaults. All settings are
# optional — defaults live in utils/config.py.

# ── Browser ───────────────────────────────────────────────────────────
BROWSER=chrome           # chrome | firefox | edge
HEADLESS=false           # true for CI / unattended runs

# ── Target site ───────────────────────────────────────────────────────
BASE_URL=https://www.greenviathai.com

# ── Booking parameters ────────────────────────────────────────────────
ROUTE=Ranong
ROUTE_VALUE=2            # <select> option value (Ranong=2, Satun=3)
TRIP_DATE=2026-05-17     # ISO YYYY-MM-DD
ADULT_COUNT=2
CHILD_COUNT=1

# ── Timeouts (seconds) ────────────────────────────────────────────────
IMPLICIT_WAIT=5
EXPLICIT_WAIT=20
PAGE_LOAD_TIMEOUT=30

# Pause inserted between user-style actions so the run is visually
# readable. Lower it (or set 0) for fast / CI runs.
HUMAN_DELAY=1.2

# Hard pause after clicking the 'Border Trip' nav link so the page's
# late-binding JS handlers can finish attaching before the next click.
BORDER_TRIP_LOAD_WAIT=5
