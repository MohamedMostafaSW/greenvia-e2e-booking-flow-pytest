# ── Browser ────────────────────────────────────────────────────────────────
BROWSER=chrome          # chrome | firefox | edge
HEADLESS=false          # true for CI

# ── Target ─────────────────────────────────────────────────────────────────
BASE_URL=https://www.greenviathai.com

# ── Auth method ────────────────────────────────────────────────────────────
# google: log in via Google OAuth (matches the task spec; recommended)
# internal: log in via /web/login email+password (fallback if Google is blocked)
AUTH_METHOD=google

# Recommended: complete login once via `pytest --setup-auth` (manual cookie
# capture); subsequent runs will reuse the saved session and ignore the
# credentials below.

# ── Google OAuth test account (used if AUTH_METHOD=google) ─────────────────
# Supply a dedicated Google test account.
GOOGLE_EMAIL=your-test-account@gmail.com
GOOGLE_PASSWORD=your-password

# ── Internal credentials (used if AUTH_METHOD=internal) ────────────────────
INTERNAL_EMAIL=your-greenvia-account@example.com
INTERNAL_PASSWORD=your-password

# ── Session persistence ────────────────────────────────────────────────────
SESSION_COOKIE_FILE=fixtures/session_cookies.json

# ── Timeouts (seconds) ──────────────────────────────────────────────────────
IMPLICIT_WAIT=5
EXPLICIT_WAIT=20
PAGE_LOAD_TIMEOUT=30

# ── Booking params (override per-run if site data changes) ─────────────────
# Trip date should be a future date when running tests. May 17 is the spec
# default; bump the year if running after that date has passed.
TRIP_DATE=2026-05-17
TRIP_DATE_DISPLAY=May 17
PASSENGER_COUNT=3
ROUTE=Ranong
ROUTE_VALUE=2
ORIGIN=Phuket
ORIGIN_VALUE=1
