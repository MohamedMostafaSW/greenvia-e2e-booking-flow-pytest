# Project-level fallback .gitignore (the canonical one is at the repo root).

__pycache__/
*.py[cod]
.pytest_cache/

# Generated reports / screenshots — regenerated every run
reports/*.html
reports/screenshots/*
!reports/screenshots/.gitkeep

# Auto-generated upload fixtures
fixtures/files/*
!fixtures/files/.gitkeep

# Sensitive — never commit
.env
.env.*
!.env.example

# IDE
.idea/workspace.xml
.idea/shelf/

# OS
.DS_Store
Thumbs.db
*.swp
